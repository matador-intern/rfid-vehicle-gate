# ---------------------------------------------------------------------------
# RFID Vehicle Gate - contoh konfigurasi lokal.
# Salin file ini menjadi `.env` lalu sesuaikan. JANGAN commit file `.env`.
# ---------------------------------------------------------------------------

# --- Network (subnet 192.168.10.0/24) ---
RFID_READER_HOST=192.168.10.10
RFID_READER_PORT=6000

WAVESHARE_RELAY_HOST=192.168.10.20
WAVESHARE_RELAY_PORT=502
WAVESHARE_RELAY_UNIT_ID=1

# --- RFID TCP server (listener di Raspberry Pi) ---
RFID_TCP_BIND_HOST=0.0.0.0
RFID_TCP_BIND_PORT=6000

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rfid_vehicle_gate
DB_USER=magang
DB_PASSWORD=rfid_123

# --- MQTT ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_VEHICLE_REGISTERED=vehicle/registered
MQTT_CLIENT_ID_RFID=rfid-publisher
MQTT_CLIENT_ID_RELAY=relay-subscriber

# --- Relay behaviour ---
RELAY_ON_DURATION_SECONDS=3

# --- Logging ---
LOG_LEVEL=INFO
